# Copy to .env.local (local) or set these in Vercel -> Project -> Settings -> Environment Variables.

# ---- Database: Supabase Postgres ----
# Supabase dashboard -> your project -> Connect -> "Transaction pooler" URI (port 6543).
# Leave empty to use the embedded Postgres (PGlite) in .data/ for local runs - no setup needed.
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ---- Auth ----
# Long random string (e.g. `openssl rand -hex 32`). If empty, one is generated and stored in the DB.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- First run (optional) ----
# If both are set, the Admin account is created on first boot and the setup screen is skipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=

# ---- AI assistant: any OpenAI-compatible API with tool calling (server-side only) ----
# Groq (free):   AI_BASE_URL=https://api.groq.com/openai/v1                              AI_MODEL=llama-3.3-70b-versatile
# Gemini (free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai     AI_MODEL=gemini-2.5-flash
# OpenRouter:    AI_BASE_URL=https://openrouter.ai/api/v1                                AI_MODEL=meta-llama/llama-3.3-70b-instruct
# Without a key the built-in offline assistant answers (same tools, same permissions).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20
